{
  "name": "Ascendlyx Frontend Production Config",
  "version": "1.0.0",
  "description": "Production-ready configuration for Ascendlyx Angular application",
  "scripts": {
    "start": "ng serve --open",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "test": "ng test",
    "test:ci": "ng test --watch=false --code-coverage --browsers=ChromeHeadless",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "analyze": "webpack-bundle-analyzer dist/frontend/browser/stats.json",
    "docker:build": "docker build -f docker/Dockerfile -t ascendlyx-frontend:latest .",
    "docker:run": "docker run -p 80:80 ascendlyx-frontend:latest"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
